NODE_ENV=development
PORT=8000
DATABASE_PATH=./data/bara-studios.sqlite
# Set DATABASE_URL in Vercel to a Neon PostgreSQL connection string.
DATABASE_URL=
CURRENCY=ZAR

# Use a unique email and a long password (at least 16 characters).
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# Admin alerts: email via Resend; SMS, WhatsApp, and voice via Twilio.
ADMIN_ALERT_EMAIL=
ALERT_EMAIL_FROM=
RESEND_API_KEY=
ADMIN_ALERT_PHONE=
ADMIN_ALERT_WHATSAPP=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# Optional persistent browser push. Generate a key pair with:
# npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
